# --- Echte Trainingsdaten und Geheimnisse: NIE ins Repo ---
# data/config.json enthält den Passwort-Hash und den n8n-API-Key,
# data/logs/ die echten Trainings-Logs. Gesichert wird das über den
# n8n-Backup-Workflow (SPEC.md §9), nicht über Git.
# Eine data/config.example.json ohne Werte darf später versioniert werden.
data/

# --- Die Studiofotos vom iPhone: nie ins Repo ---
# 49 Originale, zusammen 134 MB, und jede Datei trägt die GPS-Koordinaten
# des Studios im EXIF. Ins Repo und auf den Server geht ausschließlich die
# aufbereitete Fassung in assets/img/exercises/: 900 Pixel, ohne Metadaten.
# Der Ordner heißt auf der Platte klein, deshalb steht er hier klein.
fotos/

# --- Die generierten Übungsbilder in voller Größe: nie ins Repo ---
# 25 PNG mit 2400 px, je rund 7 MB, zusammen 176 MB. Angezeigt wird
# davon nie eines. In der App liegt die 1200er Webfassung aus
# assets/img/exercises/, rund 220 KB. Die Originale bleiben auf der
# Platte, damit sich die Webfassung jederzeit neu rechnen lässt.
images/

# --- System ---
.DS_Store
