# Sicherer Standard für den Schutz der Daten (SPEC.md §8).
#
# Greift unabhängig davon, ob data/ auf dem Server eine Ebene über dem
# Web-Root liegt. Falls beides geht, gilt beides. Prüfen lässt sich das nur
# auf dem echten Host: der eingebaute PHP-Server liest keine .htaccess.

Options -Indexes

# Der komplette data/-Baum ist aus dem Browser nicht erreichbar. Dort
# liegen Passwort-Hash, API-Key und die Trainingsdaten.
#
# In data/ liegt zusätzlich eine eigene .htaccess mit derselben Sperre.
# Zwei Riegel, weil hier alles daran hängt: geht diese Datei bei einem
# Deployment verloren oder greift eine Regel nach einer Änderung an der
# Apache-Konfiguration nicht mehr, wäre der Passwort-Hash herunterladbar.
RedirectMatch 404 ^/data(/|$)

# Sperr- und Zwischendateien des atomaren Schreibens.
<FilesMatch "\.(lock|tmp)$">
    Require all denied
</FilesMatch>

# Interne Bibliothek und das Einrichtungsskript gehören nicht ins Web.
# bin/ wird ohnehin nicht hochgeladen, die Regel ist die Absicherung dagegen,
# es doch einmal zu tun.
RedirectMatch 404 ^/(lib|bin)(/|$)

# manifest.json und service-worker.js müssen erreichbar bleiben, sonst
# funktioniert die PWA nicht. Deshalb hier bewusst keine Sperre auf *.json.

# Der Service Worker entscheidet, was zwischengespeichert wird. Läge er
# selbst lange im Cache, bliebe ein Gerät auf einer alten Fassung hängen
# und bekäme Änderungen erst Tage später zu sehen.
# IfModule ist Pflicht: fehlt mod_headers, quittiert Apache die Direktive
# mit einem 500 auf der gesamten Seite.
<IfModule mod_headers.c>
    # Der Service Worker steuert, was zwischengespeichert wird. Läge er
    # selbst im Cache, bliebe ein Gerät auf einer alten Fassung hängen.
    <Files "service-worker.js">
        Header set Cache-Control "no-store, must-revalidate"
    </Files>

    # Code wird nie zwischengespeichert. Die Dateizeit in der URL würde
    # zwar reichen, aber die Regel soll ohne Wenn und Aber gelten: was
    # ausgeliefert wird, ist der aktuelle Stand.
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-store, must-revalidate"
    </FilesMatch>

    # Die Gerätefotos ändern sich praktisch nie und wiegen zusammen 2 MB.
    # Die bei jedem Aufruf neu über schlechten Studioempfang zu ziehen,
    # wäre die falsche Sparsamkeit. Sie bekommen einen neuen Dateinamen,
    # wenn sich etwas ändert.
    <FilesMatch "\.(jpg|png)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
